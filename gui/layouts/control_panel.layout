// ============================================================================
//  BZ_AutoDrive - Control Panel layout (px absolutos, mismo enfoque que bus_stop)
//  Panel 600x480 centrado. Pestañas: Vehiculo (v1) + Grabacion (v1.2).
//  Textos fijos via stringtable (#STR_BZAD_cp_*) -> se traducen al CreateWidgets.
//  Los dos grupos (GroupVehicle / GroupRecord) ocupan el mismo espacio; el script
//  muestra uno y oculta el otro segun la pestaña activa.
// ============================================================================

PanelWidgetClass Root {
 ignorepointer 0
 color 0 0 0 0.55
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 999
 {
  PanelWidgetClass Panel {
   ignorepointer 0
   color 0.05 0.05 0.05 0.94
   position 0.5 0.5
   halign center
   valign center
   size 600 480
   hexactpos 0
   vexactpos 0
   hexactsize 1
   vexactsize 1
   {
    TextWidgetClass Title {
     ignorepointer 1
     color 0.9 0.75 0.2 1
     position 16 12
     size 480 28
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text "#STR_BZAD_cp_title"
     font "gui/fonts/sdf_RobotoBold18"
     "text halign" left
     "text valign" center
    }

    ButtonWidgetClass CloseBtn {
     ignorepointer 0
     color 0.7 0.15 0.15 0.9
     position 540 8
     size 48 30
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text "X"
     font "gui/fonts/sdf_RobotoBold18"
     "text halign" center
     "text valign" center
     style DayZDefaultButton
    }

    ButtonWidgetClass TabVehicleBtn {
     ignorepointer 0
     color 0.2 0.35 0.5 0.95
     position 16 46
     size 180 32
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text "#STR_BZAD_cp_tab_vehicle"
     font "gui/fonts/sdf_RobotoBold18"
     "text halign" center
     "text valign" center
     style DayZDefaultButton
    }

    ButtonWidgetClass TabRecordBtn {
     ignorepointer 0
     color 0.18 0.18 0.22 0.95
     position 204 46
     size 180 32
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     text "#STR_BZAD_cp_tab_record"
     font "gui/fonts/sdf_RobotoBold18"
     "text halign" center
     "text valign" center
     style DayZDefaultButton
    }

    // ===================== GRUPO VEHICULO =====================
    PanelWidgetClass GroupVehicle {
     ignorepointer 0
     color 0 0 0 0
     position 0 0
     size 600 480
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     {
      TextWidgetClass StatusText {
       ignorepointer 1
       color 0.7 0.85 0.7 1
       position 16 92
       size 568 30
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "..."
       font "gui/fonts/sdf_RobotoRegular14"
       "text halign" left
       "text valign" center
      }

      TextWidgetClass RouteLabel {
       ignorepointer 1
       color 0.95 0.95 0.95 1
       position 16 132
       size 568 26
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "Ruta: Default"
       font "gui/fonts/sdf_RobotoRegular14"
       "text halign" left
       "text valign" center
      }

      ButtonWidgetClass RoutePrevBtn {
       ignorepointer 0
       color 0.2 0.2 0.25 0.9
       position 16 164
       size 60 34
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "<"
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" center
       "text valign" center
       style DayZDefaultButton
      }

      ButtonWidgetClass RouteNextBtn {
       ignorepointer 0
       color 0.2 0.2 0.25 0.9
       position 84 164
       size 60 34
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text ">"
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" center
       "text valign" center
       style DayZDefaultButton
      }

      ButtonWidgetClass SpawnBtn {
       ignorepointer 0
       color 0.15 0.45 0.18 0.95
       position 16 220
       size 280 44
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "#STR_BZAD_cp_spawn"
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" center
       "text valign" center
       style DayZDefaultButton
      }

      ButtonWidgetClass StopBtn {
       ignorepointer 0
       color 0.5 0.3 0.1 0.95
       position 304 220
       size 280 44
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "#STR_BZAD_cp_stop"
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" center
       "text valign" center
       style DayZDefaultButton
      }

      ButtonWidgetClass ResetBtn {
       ignorepointer 0
       color 0.2 0.25 0.45 0.95
       position 16 276
       size 280 44
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "#STR_BZAD_cp_reset"
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" center
       "text valign" center
       style DayZDefaultButton
      }

      ButtonWidgetClass PauseBtn {
       ignorepointer 0
       color 0.35 0.35 0.2 0.95
       position 304 276
       size 280 44
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "#STR_BZAD_cp_pause"
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" center
       "text valign" center
       style DayZDefaultButton
      }

      TextWidgetClass HelpText {
       ignorepointer 1
       color 0.6 0.6 0.6 1
       position 16 340
       size 568 120
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "#STR_BZAD_cp_help"
       font "gui/fonts/sdf_RobotoRegular12"
       "text halign" left
       "text valign" top
       multiline 1
      }
     }
    }

    // ===================== GRUPO GRABACION =====================
    PanelWidgetClass GroupRecord {
     ignorepointer 0
     color 0 0 0 0
     position 0 0
     size 600 480
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     {
      TextWidgetClass RecStateText {
       ignorepointer 1
       color 0.9 0.85 0.6 1
       position 16 92
       size 568 30
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "..."
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" left
       "text valign" center
      }

      ButtonWidgetClass RecBtn {
       ignorepointer 0
       color 0.5 0.15 0.15 0.95
       position 16 128
       size 280 44
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "#STR_BZAD_cp_rec_start"
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" center
       "text valign" center
       style DayZDefaultButton
      }

      ButtonWidgetClass RecPauseBtn {
       ignorepointer 0
       color 0.35 0.35 0.2 0.95
       position 304 128
       size 280 44
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "#STR_BZAD_cp_rec_pause"
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" center
       "text valign" center
       style DayZDefaultButton
      }

      ButtonWidgetClass MarkBtn {
       ignorepointer 0
       color 0.2 0.4 0.45 0.95
       position 16 180
       size 568 40
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "#STR_BZAD_cp_rec_mark"
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" center
       "text valign" center
       style DayZDefaultButton
      }

      TextWidgetClass ModeLabel {
       ignorepointer 1
       color 0.95 0.95 0.95 1
       position 16 230
       size 568 24
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "Modo:"
       font "gui/fonts/sdf_RobotoRegular14"
       "text halign" left
       "text valign" center
      }

      ButtonWidgetClass ModeNormalBtn {
       ignorepointer 0
       color 0.18 0.18 0.22 0.95
       position 16 258
       size 134 36
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "#STR_BZAD_cp_mode_normal"
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" center
       "text valign" center
       style DayZDefaultButton
      }

      ButtonWidgetClass ModeParkingBtn {
       ignorepointer 0
       color 0.18 0.18 0.22 0.95
       position 158 258
       size 134 36
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "#STR_BZAD_cp_mode_parking"
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" center
       "text valign" center
       style DayZDefaultButton
      }

      ButtonWidgetClass ModeManiobraBtn {
       ignorepointer 0
       color 0.18 0.18 0.22 0.95
       position 300 258
       size 134 36
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "#STR_BZAD_cp_mode_maniobra"
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" center
       "text valign" center
       style DayZDefaultButton
      }

      ButtonWidgetClass ModeReverseBtn {
       ignorepointer 0
       color 0.18 0.18 0.22 0.95
       position 442 258
       size 134 36
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "#STR_BZAD_cp_mode_reverse"
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" center
       "text valign" center
       style DayZDefaultButton
      }

      TextWidgetClass RecHelpText {
       ignorepointer 1
       color 0.6 0.6 0.6 1
       position 16 304
       size 568 160
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "#STR_BZAD_cp_rec_help"
       font "gui/fonts/sdf_RobotoRegular12"
       "text halign" left
       "text valign" top
       multiline 1
      }
     }
    }
   }
  }
 }
}
