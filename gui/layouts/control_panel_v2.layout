       ignorepointer 1
       color 0.72 0.80 0.88 1
       position 16 10 size 900 46
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text "Select a route to see its info"
       font "gui/fonts/sdf_RobotoRegular12"
       "text halign" left "text valign" top
       multiline 1
      }
      // SCRUBBER PROPIO (el SliderWidget nativo necesita skin que no tenemos -> no arrastraba).
      // Track = base clickeable; Fill = progreso (el script le setea el ancho); Thumb = manija (SetPos).
      // El arrastre se maneja en el script: OnMouseButtonDown(Track) + polling de GetMousePos en Update.
