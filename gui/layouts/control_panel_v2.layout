    // ===================== OVERLAY DE AYUDA (boton "?") =====================
    // Modal DENTRO del panel: cubre el cuerpo (deja el header con el "?" clickeable). El script
    // (BZReproductorUI) lo arranca oculto y lo togglea con el "?" / CERRAR. Bilingue ES|EN (boton).
    // Reusa el mismo fondo metalico del panel (bz_metal_panel) para que se vea consistente.
    PanelWidgetClass HelpOverlay {
     ignorepointer 0
     color 0.055 0.07 0.09 1
     position 16 74 size 1318 640
     hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
     {
      ImageWidgetClass HelpBg {
       ignorepointer 1 color 1 1 1 1
       imageTexture "BZ_AutoDrive/gui/textures/bz_metal_panel.paa"
       position 0 0 size 1318 640
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       mode blend "src alpha" 1 stretch 1 filter 1
      }
