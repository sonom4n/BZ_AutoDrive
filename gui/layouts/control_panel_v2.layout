       ignorepointer 1 color 0.85 0.9 0.95 1
       position 24 12 size 900 28
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text "AYUDA"
       font "gui/fonts/sdf_RobotoBold18" "text halign" left "text valign" center
      }
      ButtonWidgetClass HelpLangBtn {
       ignorepointer 0 color 0.15 0.35 0.5 0.97
       position 1116 12 size 96 28
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text "ES | EN"
       font "gui/fonts/sdf_RobotoRegular12" "text halign" center "text valign" center
       style DayZDefaultButton
      }
      ButtonWidgetClass HelpCloseBtn {
       ignorepointer 0 color 0.42 0.2 0.16 0.97
       position 1220 12 size 82 28
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text "CERRAR"
       font "gui/fonts/sdf_RobotoRegular12" "text halign" center "text valign" center
       style DayZDefaultButton
      }
      // Caja de texto DELIMITADA (inset oscuro) + SCROLL. Va MultilineTextWidget (no TextWidget):
      // el ScrollWidget lo scrollea si el contenido supera el viewport (patron del chat de Boris).
      ImageWidgetClass HelpBoxBg {
       ignorepointer 1 color 0.05 0.065 0.09 1
       imageTexture "BZ_AutoDrive/gui/textures/bz_card.paa"
       position 18 46 size 1282 588
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       mode blend "src alpha" 1 stretch 1 filter 1
      }
      // FILAS DE LINEA (HelpLine0..24) — patron de la lista de runners: el script pagina las ~51 lineas
      // del texto en esta ventana de 25 filas (rueda = scroll) y colorea por fila (titulos en cyan via
