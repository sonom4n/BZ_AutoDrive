    // ===================== PREVIEW de la toma (franja full-width, debajo) =====================
    // Paso 1 del scrubber: al seleccionar una ruta el script pide la info al server (RequestRouteInfo)
    // y llena PreviewText con vehiculo / N wps / distancia / vel max. Paso 2 sumara aca el slider +
    // los botones INICIO/FINAL (spawn del vehiculo vacio en cualquier wp).
    PanelWidgetClass PreviewPanel {
     ignorepointer 0
     color 0.085 0.10 0.13 0.95
     position 16 578 size 1318 130
     hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
     {
      ImageWidgetClass PreviewBg {
       ignorepointer 1
       color 1 1 1 1
