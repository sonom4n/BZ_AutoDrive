// ============================================================================
//  BZ_AutoDrive - Control Panel v2 (reproductor) — esqueleto fiel al mockup.
//  Panel 800x500 (16:10) centrado. Tema oscuro + acento cyan. Solido por ahora;
//  el gradiente/glow/logo entran como texturas (Etapa 3). Nombres de widget pensados
//  para que el script (Etapa 4) los tome con GetWidget: RouteRow0..N, Runner0_*, Hk0..N.
//  Formato CPP-style (PanelWidgetClass) — XML/library crashea CreateWidgets.
// ============================================================================

PanelWidgetClass Root {
 ignorepointer 0
 color 0 0 0 0.55
 position 0 0
 size 1 1
 hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
 priority 999
 {
  PanelWidgetClass Panel {
   ignorepointer 0
   color 0.055 0.07 0.09 0.97
   position 0.5 0.5
   halign center valign center
   size 1350 744
   hexactpos 0 vexactpos 0 hexactsize 1 vexactsize 1
   {
    // FONDO del panel: PanelWidget.color NO se renderiza en DayZ -> textura via ImageWidget.
    // Va PRIMERO (capa de atras). ignorepointer 1 para no bloquear los clicks de arriba.
    ImageWidgetClass PanelBg {
     ignorepointer 1
     color 1 1 1 1
     imageTexture "BZ_AutoDrive/gui/textures/bz_metal_panel.paa"
     position 0 0
     size 1350 744
     hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
     mode blend
     "src alpha" 1
     stretch 1
     filter 1
    }

    // ===================== HEADER =====================
    // Logo texturizado (wordmark con gradiente+glow). PAA 1024x256 (4:1), aspecto fijo
    // -> no sufre distorsion de stretch. Reemplaza al texto "BZ_AutoDrive".
    ImageWidgetClass Logo {
     ignorepointer 1
     color 1 1 1 1
     imageTexture "BZ_AutoDrive/gui/textures/bz_metal_logo.paa"
     position 14 2
     size 340 80
     hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
     mode blend
     "src alpha" 1
     stretch 1
     filter 1
    }
    // Subtitle removido (el logo BZ_AutoDrive ya es la marca; se agrando y ocupa este espacio).
    ButtonWidgetClass HelpBtn {
     ignorepointer 0
     color 0.12 0.45 0.6 0.95
     position 1104 18 size 34 26
     hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
     text "?"
     font "gui/fonts/sdf_RobotoBold18"
     "text halign" center "text valign" center
     style DayZDefaultButton
    }
    ButtonWidgetClass StopAllBtn {
     ignorepointer 0
     color 0.42 0.2 0.16 0.95
     position 1146 18 size 96 26
     hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
     text "STOP ALL"
     font "gui/fonts/sdf_RobotoRegular12"
     "text halign" center "text valign" center
     style DayZDefaultButton
    }
    ButtonWidgetClass DbgBtn {
     ignorepointer 0
     color 0.10 0.30 0.40 0.95
     position 1250 18 size 44 26
     hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
     text "DBG"
     font "gui/fonts/sdf_RobotoRegular12"
     "text halign" center "text valign" center
     style DayZDefaultButton
    }
    ButtonWidgetClass CloseBtn {
     ignorepointer 0
     color 0.12 0.45 0.6 0.95
     position 1302 14
     size 34 34
     hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
     text "X"
     font "gui/fonts/sdf_RobotoBold18"
     "text halign" center
     "text valign" center
     style DayZDefaultButton
    }

    // ===================== PANEL ROUTES (izquierda) =====================
    PanelWidgetClass RoutesPanel {
     ignorepointer 0
     color 0.085 0.10 0.13 0.95
     position 16 74
     size 420 494
     hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
     {
      ImageWidgetClass RoutesBg {
       ignorepointer 1
       color 1 1 1 1
       imageTexture "BZ_AutoDrive/gui/textures/bz_metal_card.paa"
       position 0 0 size 420 494
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       mode blend "src alpha" 1 stretch 1 filter 1
      }
      TextWidgetClass RoutesHdr {
       ignorepointer 1
       color 0.85 0.9 0.95 1
       position 14 10
       size 396 22
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text "ROUTES"
       font "gui/fonts/sdf_RobotoBold18"
       "text halign" left "text valign" center
      }
      // Resaltado de la fila SELECCIONADA (persistente hasta LOAD). ButtonWidget.SetColor() lo pisa el
      // engine -> no sirve para colorear el boton. Workaround: esta barra azul claro (look HOVER) va DETRAS
      // de los RouteRow (declarada ANTES = capa de fondo). RenderRoutes la reposiciona leyendo la pos/size
      // REAL del boton seleccionado (GetPos/GetSize, sin magic numbers). Los RouteRow tienen fondo
      // semi-transparente (alpha ~0.5) -> la barra de atras ASOMA como tint, y el NOMBRE (texto del boton,
      // capa de arriba) queda LEGIBLE encima. ignorepointer 1: no bloquea el click. Posicion/visibilidad
      // las setea el script (oculto por defecto).
      ImageWidgetClass RouteSelBg {
       ignorepointer 1
       color 0.22 0.55 0.78 0.9
       imageTexture "BZ_AutoDrive/gui/textures/bz_card.paa"
       position 12 42 size 404 34
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       mode blend "src alpha" 1 stretch 1 filter 1
      }
      ButtonWidgetClass RouteRow0 {
       ignorepointer 0 color 0.13 0.16 0.20 0.55
       position 12 42 size 404 34
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text "  -" font "gui/fonts/sdf_RobotoRegular12" "text halign" left "text valign" center
      }
      ButtonWidgetClass RouteRow1 {
       ignorepointer 0 color 0.13 0.16 0.20 0.55
       position 12 80 size 404 34
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text "  -" font "gui/fonts/sdf_RobotoRegular12" "text halign" left "text valign" center
      }
      ButtonWidgetClass RouteRow2 {
       ignorepointer 0 color 0.13 0.16 0.20 0.55
       position 12 118 size 404 34
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text "  -" font "gui/fonts/sdf_RobotoRegular12" "text halign" left "text valign" center
      }
      ButtonWidgetClass RouteRow3 {
       ignorepointer 0 color 0.13 0.16 0.20 0.55
       position 12 156 size 404 34
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text "  -" font "gui/fonts/sdf_RobotoRegular12" "text halign" left "text valign" center
      }
      ButtonWidgetClass RouteRow4 {
       ignorepointer 0 color 0.13 0.16 0.20 0.55
       position 12 194 size 404 34
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text "  -" font "gui/fonts/sdf_RobotoRegular12" "text halign" left "text valign" center
      }
      ButtonWidgetClass RouteRow5 {
       ignorepointer 0 color 0.13 0.16 0.20 0.55
       position 12 232 size 404 34
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text "  -" font "gui/fonts/sdf_RobotoRegular12" "text halign" left "text valign" center
      }
      ButtonWidgetClass RouteRow6 {
       ignorepointer 0 color 0.13 0.16 0.20 0.55
       position 12 270 size 404 34
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text "  -" font "gui/fonts/sdf_RobotoRegular12" "text halign" left "text valign" center
      }
      ButtonWidgetClass RouteRow7 {
       ignorepointer 0 color 0.13 0.16 0.20 0.55
       position 12 308 size 404 34
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text "  -" font "gui/fonts/sdf_RobotoRegular12" "text halign" left "text valign" center
      }
      // Checks de logger (opt-in por corrida): arman boris_native / ai_run en sincro con el play.
      ButtonWidgetClass LogNativeChk {
       ignorepointer 0 color 0.16 0.20 0.26 0.95
       position 12 418 size 198 24
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text " [ ] boris_native"
       font "gui/fonts/sdf_RobotoRegular12" "text halign" left "text valign" center
       style DayZDefaultButton
      }
      ButtonWidgetClass LogAiChk {
       ignorepointer 0 color 0.16 0.20 0.26 0.95
       position 218 418 size 198 24
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text " [ ] ai_run"
       font "gui/fonts/sdf_RobotoRegular12" "text halign" left "text valign" center
       style DayZDefaultButton
      }
      ButtonWidgetClass LoadSpawnBtn {
       ignorepointer 0
       color 0.15 0.55 0.82 0.97
       position 12 448 size 404 34
       hexactpos 1 vexactpos 1 hexactsize 1 vexactsize 1
       text "LOAD & SPAWN"
       font "gui/fonts/sdf_RobotoBold18" "text halign" center "text valign" center
       style DayZDefaultButton
      }
     }
    }

    // ===================== PANEL ACTIVE RUNNERS (derecha-arriba) =====================
